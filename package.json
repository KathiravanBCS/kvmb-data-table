{
  "name": "@kvmb/react-data-grid",
  "version": "0.1.0",
  "description": "Enterprise React data grid for Mantine: sorting, advanced filtering, editing, grouping, virtualization, drag & drop and CSV/Excel export, powered by TanStack Table.",
  "keywords": [
    "react",
    "mantine",
    "data-grid",
    "datagrid",
    "table",
    "tanstack-table",
    "virtualization",
    "excel",
    "csv",
    "typescript"
  ],
  "license": "MIT",
  "author": "Kathiravan <kathiravanvittopa717@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KathiravanBCS/kvmb-data-table.git"
  },
  "homepage": "https://github.com/KathiravanBCS/kvmb-data-table#readme",
  "bugs": {
    "url": "https://github.com/KathiravanBCS/kvmb-data-table/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./export": {
      "import": {
        "types": "./dist/export/index.d.ts",
        "default": "./dist/export/index.js"
      },
      "require": {
        "types": "./dist/export/index.d.cts",
        "default": "./dist/export/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && npm run build:types && rollup -c && npm run clean:types",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:types": "node -e \"require('fs').rmSync('dist/types',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck.only",
    "test:e2e": "playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "check:exports": "publint && attw --pack . --profile node16 --exclude-entrypoints styles.css",
    "playground": "vite --config examples/vite.config.ts",
    "docs:dev": "vite --config docs/vite.config.ts",
    "docs:build": "vite build --config docs/vite.config.ts",
    "bench": "vitest bench --run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@mantine/core": ">=8.3.0 <9",
    "@mantine/dates": ">=8.3.0 <9",
    "@mantine/hooks": ">=8.3.0 <9",
    "dayjs": ">=1.11.0",
    "exceljs": "^4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.21",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@mantine/core": "8.3.18",
    "@mantine/dates": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "cssnano": "^7.1.9",
    "dayjs": "^1.11.23",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^17.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.64.12",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "private": false,
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
